    },
    "./hierarchy": {
      "import": "./dist/hierarchy.js",
      "types": "./dist/hierarchy.d.ts"
    },
    "./collaboration": {
      "import": "./dist/collaboration.js",
      "types": "./dist/collaboration.d.ts"
    },
    "./endorsement": {
      "import": "./dist/endorsement.js",
