    },
    "./ratings": {
      "import": "./dist/ratings.js",
      "types": "./dist/ratings.d.ts"
    },
    "./tracking": {
      "import": "./dist/tracking.js",
      "types": "./dist/tracking.d.ts"
    },
    "./nutrition": {
      "import": "./dist/nutrition.js",
      "types": "./dist/nutrition.d.ts"
